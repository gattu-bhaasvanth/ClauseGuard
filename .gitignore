# ==============================================================================
# ClauseGuard .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Quality Tooling (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Node & Next.js
node_modules/
.pnp
.pnp.js
coverage/
.next/
out/
build/
.turbo/
*.tsbuildinfo

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Application Runtime Data & Uploads
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/cache/*
!data/cache/.gitkeep

# OCR & Model Checkpoints / Weights
*.pt
*.pth
*.onnx
*.bin
*.safetensors
models/checkpoints/*
!models/checkpoints/.gitkeep

# Logs
logs/
*.log
