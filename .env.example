# ==============================================================================
# ClauseGuard Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local development setup.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE API KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Mode & General Settings
APP_ENV=development                   # development | staging | production
APP_NAME=ClauseGuard
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_USER=clauseguard_user
POSTGRES_PASSWORD=clauseguard_password
POSTGRES_DB=clauseguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://clauseguard_user:clauseguard_password@localhost:5432/clauseguard_db

# LLM Providers Configuration (Modular Provider Layer)
# Supported options for LLM_PROVIDER: "gemini" | "openai" | "anthropic" | "local"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embeddings & Vector Store Configuration
# Supported options for VECTOR_DB_TYPE: "chroma" | "faiss"
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Document Processing & Storage
STORAGE_LOCAL_DIR=./data/uploads
PROCESSED_DATA_DIR=./data/processed
OCR_ENGINE=paddleocr                   # paddleocr | tesseract | none
OCR_FALLBACK_ENABLED=true
MAX_UPLOAD_SIZE_MB=50

# Frontend Configuration (Next.js)
NEXT_PUBLIC_APP_NAME=ClauseGuard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
